#cloud-config
# STUB ONLY — do not copy to bootfs with a real password.
# Use:  prepare-boot.ps1 -Unattended ...
# which generates user-data (hostname, user, SSH password/key, Wi-Fi, firstboot).
#
# This file exists so older docs mentioning cloud-init.user-data still resolve.
# Prefer -Unattended; Imager = flash Lite only (no OS customisation).

hostname: netdiag-sat
manage_etc_hosts: true

# No users / passwords here on purpose.
runcmd:
  - [ bash, -c, "echo 'Use prepare-boot.ps1 -Unattended to generate user-data' >&2; exit 1" ]
