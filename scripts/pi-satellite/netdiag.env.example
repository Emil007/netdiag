# Copy to the Pi boot partition as: netdiag.env
# (Windows: the FAT volume labeled bootfs after Raspberry Pi Imager)
#
# MODE=wired  → ethernet to main router (Fritzbox), vantage sat-fritz-wired
# MODE=wifi   → Wi-Fi (Pi 2 needs USB Wi-Fi), vantage sat-wifi
#
# Must match coordinator satellites[].id and NETDIAG_INGEST_TOKEN.

NETDIAG_MODE=wired
NETDIAG_COORDINATOR_URL=http://192.168.1.10:8787/ingest
NETDIAG_TOKEN=change-me

# Optional overrides:
# NETDIAG_VANTAGE_ID=sat-fritz-wired
# NETDIAG_IFACE=eth0
# SITE_NAME="Home LAN"
# TZ=Europe/Berlin
# NETDIAG_DNS_RESOLVER=192.168.1.1
# DNS_NAMES=example.com,cloudflare.com

# Prefer also copying netdiag.groups.yaml (mirror coordinator canaries).
